@model List<MYAcademy_IdentitiyEmailProject.Entities.Category>
@{
    // Kategori renkleri: gelen kutusundaki etiket renkleriyle aynı sıra
    var dotColors = new[] { "#8B7FD6", "#5CC09A", "#EBA27A", "#6FA8E8" };
}
<!-- =====================================================================
      SHARED SIDEBAR
      ASP.NET Core MVC: Views/Shared/_Sidebar.cshtml (partial) — _Layout.cshtml içinde
      Menü linkleri ileride asp-controller / asp-action ile değiştirilecek.
      ===================================================================== -->
<aside class="app-sidebar" id="appSidebar" aria-label="Ana menü">
    <a class="brand" data-page="inbox" href="/Message/Inbox">
        <div class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
        <div class="brand-name">Mail<span>ora</span></div>
    </a>

    <button class="btn-compose" data-page="compose" type="button" data-tip="Yeni Mesaj" onclick="location.href='/Message/CreateMessage'">
        <i class="bi bi-pencil-square"></i> <span class="lbl">Yeni Mesaj</span>
    </button>

    <div class="nav-section-title">Menü</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="dashboard" href="/Dashboard/Index" data-tip="Dashboard">
        <li><a class="side-link" data-page="inbox" href="/Message/Inbox" data-tip="Gelen Kutusu"><i class="bi bi-inbox"></i> <span class="lbl">Gelen Kutusu</span> <span class="side-badge" id="badgeInbox"></span></a></li>
        <li><a class="side-link" data-page="sent" href="/Message/SendBox" data-tip="Gönderilenler"><i class="bi bi-send"></i> <span class="lbl">Gönderilenler</span></a></li>
        <li>
            <a class="side-link" data-page="drafts" href="/Message/Drafts" data-tip="Taslaklar">
                <i class="bi bi-file-earmark-text"></i> <span class="lbl">Taslaklar</span> @if ((int)(ViewBag.DraftCount ?? 0) > 0) {
                <span class="side-badge muted">@ViewBag.DraftCount</span>
                                }
            </a>
        </li>
        <li><a class="side-link" data-page="starred" href="/Message/Starred" data-tip="Yıldızlı Mesajlar"><i class="bi bi-star"></i> <span class="lbl">Yıldızlı Mesajlar</span> <span class="side-badge muted" id="badgeStarred"></span></a></li>
        <li><a class="side-link" data-page="trash" href="/Message/Trash" data-tip="Çöp Kutusu"><i class="bi bi-trash3"></i> <span class="lbl">Çöp Kutusu</span> <span class="side-badge muted" id="badgeTrash"></span></a></li>
    </ul>

    <div class="nav-section-title">Hesap</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="profile" href="/Profile/Index" data-tip="Profilim"><i class="bi bi-person-circle"></i> <span class="lbl">Profilim</span></a></li>
        <li><a class="side-link" data-page="settings" href="/Password/ChangePassword" data-tip="Ayarlar"><i class="bi bi-gear"></i> <span class="lbl">Ayarlar</span></a></li>
    </ul>

    <div class="nav-section-title">Etiketler</div>
    <ul class="side-labels">
        @foreach (var c in Model ?? new List<MYAcademy_IdentitiyEmailProject.Entities.Category>())
        {
            <li><a data-label="@c.CategoryName" data-tip="@c.CategoryName"><span class="dot" style="background:@(dotColors[Math.Abs(c.CategoryId) % dotColors.Length])"></span> <span class="lbl">@c.CategoryName</span></a></li>
        }
    </ul>

    <div class="storage-card" data-tip="Depolama · 9,3 / 15 GB">
        <div class="top">
            <div class="ic"><i class="bi bi-cloud"></i></div>
            <div>
                <div class="t1">Depolama</div>
                <div class="t2">9,3 GB / 15 GB kullanıldı</div>
            </div>
        </div>
        <div class="storage-bar"><span></span></div>
    </div>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<!-- /SHARED SIDEBAR -->
