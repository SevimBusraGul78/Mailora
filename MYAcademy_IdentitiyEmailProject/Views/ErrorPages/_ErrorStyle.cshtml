<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ---------- Renkler (açık tema) ---------- */
    :root {
        --bg: #F8F9FD; --accent: #8B7FD6; --accent-dark: #7467C7;
        --lavender: #EAE6FA; --blue: #E8F2FF; --mint: #E3F5EE; --rose: #FBE7EE; --peach: #FDEEE6;
        --rose-ink: #C2476B; --peach-ink: #C9774A;
        --text: #303348; --muted: #85899B; --border: #ECEBF5;
        --card-bg: rgba(255, 255, 255, .72); --card-border: rgba(255, 255, 255, .9);
        --chip: #FFFFFF; --glare: rgba(255, 255, 255, .55);
        --ease: cubic-bezier(.4, 0, .2, 1);
    }

    /* ---------- Karanlık mod: bilgisayar koyu temadaysa otomatik ---------- */
    @@media (prefers-color-scheme: dark) {
        :root {
            --bg: #14131C; --text: #EEEDFE; --muted: #A9A6BF; --border: #33314A;
            --lavender: #2E2A52; --blue: #1C2740; --mint: #173229; --rose: #3A1F2B; --peach: #3A2A20;
            --rose-ink: #ED93B1; --peach-ink: #F0B48A;
            --accent: #AFA9EC; --accent-dark: #CECBF6;
            --card-bg: rgba(30, 28, 44, .72); --card-border: rgba(255, 255, 255, .08);
            --chip: #22202F; --glare: rgba(255, 255, 255, .08);
        }
    }

    * { box-sizing: border-box; }
    body {
        margin: 0; min-height: 100vh; overflow-x: hidden;
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
        background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; }

    /* ---------- Arka plan: hareketli renkli daireler ---------- */
    .err-bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
    .err-bg .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .8; animation: drift 14s ease-in-out infinite alternate; }
    .err-bg .b1 { width: 520px; height: 520px; background: var(--lavender); top: -180px; left: -140px; }
    .err-bg .b2 { width: 460px; height: 460px; background: var(--blue); bottom: -200px; right: -120px; animation-delay: -5s; }
    .err-bg .b3 { width: 320px; height: 320px; background: var(--mint); top: 45%; left: 55%; opacity: .55; animation-delay: -9s; }
    @@keyframes drift { to { transform: translate(40px, -30px) scale(1.08); } }

    /* ---------- Uçan kayıp mektuplar ---------- */
    .fly { position: absolute; left: -60px; top: 62%; font-size: 30px; color: var(--accent); opacity: 0; animation: fly 9s linear infinite; }
    .fly.f2 { top: 22%; font-size: 20px; animation-delay: -4.5s; animation-duration: 12s; }
    @@keyframes fly {
        0%   { transform: translate(0, 0) rotate(-12deg); opacity: 0; }
        10%  { opacity: .9; }
        50%  { transform: translate(55vw, -14vh) rotate(14deg); }
        90%  { opacity: .9; }
        100% { transform: translate(110vw, -6vh) rotate(-8deg); opacity: 0; }
    }

    /* ---------- Kart: buzlu cam + 3D eğilme + fareyi takip eden ışık ---------- */
    .err-page { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: 32px 20px; }
    .err-card {
        position: relative; width: 100%; max-width: 520px; text-align: center; padding: 44px 40px 30px;
        background: var(--card-bg);
        backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%);
        border: 1px solid var(--card-border); border-radius: 28px;
        box-shadow: 0 24px 60px rgba(91, 80, 170, .16);
        transition: transform .2s ease-out;
        animation: cardIn .6s var(--ease);
    }
    .err-card::after {
        content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
        background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), var(--glare), transparent 45%);
        opacity: 0; transition: opacity .3s;
    }
    .err-card:hover::after { opacity: 1; }
    .err-card > * { position: relative; z-index: 1; }
    @@keyframes cardIn { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }

    .err-brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 18px; color: var(--text); margin-bottom: 24px; }
    .err-brand b { color: var(--accent); }
    .err-brand .logo {
        width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; color: #fff;
        background: linear-gradient(135deg, #A79BEA, #7467C7); box-shadow: 0 6px 16px rgba(116, 103, 199, .35);
    }

    /* ---------- Süzülen ikon ---------- */
    .err-icon {
        width: 74px; height: 74px; margin: 0 auto 8px; border-radius: 22px; display: grid; place-items: center;
        font-size: 32px; color: var(--accent-dark); background: var(--lavender);
        animation: float 3.5s ease-in-out infinite;
    }
    .err-icon.rose { background: var(--rose); color: var(--rose-ink); }
    @@keyframes float { 50% { transform: translateY(-8px); } }

    /* ---------- Gradyan hata kodu (404'te 0 yerine zarf) ---------- */
    .err-code {
        display: flex; justify-content: center; align-items: center; gap: .04em;
        font-size: clamp(72px, 16vw, 112px); font-weight: 800; letter-spacing: -4px; line-height: 1; margin: 6px 0 12px;
    }
    .err-code .d {
        background: linear-gradient(135deg, #A79BEA 0%, #7467C7 50%, #6FA8E8 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .err-code .env {
        width: .8em; height: .8em; border-radius: .22em; display: grid; place-items: center;
        background: var(--lavender); color: var(--accent-dark); font-size: 1em;
        box-shadow: 0 10px 26px rgba(116, 103, 199, .25);
        animation: bob 2.6s ease-in-out infinite;
    }
    .err-code .env i { font-size: .5em; }
    @@keyframes bob { 50% { transform: translateY(-8px) rotate(-5deg); } }

    .err-card h1 { font-size: 24px; font-weight: 800; letter-spacing: -.5px; margin: 0 0 8px; }
    .err-card p { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 0 auto 26px; max-width: 360px; }

    /* ---------- Butonlar ---------- */
    .err-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .btn-x {
        display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 13px;
        font-weight: 700; font-size: 14px; font-family: inherit; cursor: pointer;
        transition: transform .2s var(--ease), box-shadow .2s, border-color .2s, color .2s;
    }
    .btn-x.primary { color: #fff; border: none; background: linear-gradient(135deg, #9A8EE3, #7467C7); box-shadow: 0 10px 24px rgba(116, 103, 199, .32); }
    .btn-x.primary:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(116, 103, 199, .4); color: #fff; }
    .btn-x.ghost { color: var(--text); background: var(--chip); border: 1.5px solid var(--border); }
    .btn-x.ghost:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent-dark); }

    /* ---------- Hızlı bağlantılar ---------- */
    .quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 22px; }
    .quick a {
        display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 13px 6px; border-radius: 14px;
        background: var(--chip); border: 1px solid var(--border); color: var(--muted); font-size: 12.5px; font-weight: 600;
        transition: transform .2s var(--ease), border-color .2s, color .2s;
    }
    .quick a i { font-size: 20px; color: var(--accent); }
    .quick a:hover { transform: translateY(-3px); border-color: var(--accent); color: var(--accent-dark); }

    /* ---------- 401 geri sayım halkası ---------- */
    .ring { position: relative; width: 104px; height: 104px; margin: 0 auto 10px; }
    .ring svg { transform: rotate(-90deg); }
    .ring .track { stroke: var(--peach); }
    .ring .arc { stroke: var(--peach-ink); transition: stroke-dashoffset 1s linear; }
    .ring .num { position: absolute; inset: 0; display: grid; place-items: center; font-size: 34px; font-weight: 800; color: var(--peach-ink); }
    .ring .ic { position: absolute; bottom: -4px; right: -4px; width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; background: var(--peach); color: var(--peach-ink); font-size: 16px; border: 3px solid var(--bg); }
    .stop-link { display: inline-block; margin-top: 14px; font-size: 13px; color: var(--muted); background: none; border: none; cursor: pointer; font-family: inherit; text-decoration: underline; text-underline-offset: 3px; }
    .stop-link:hover { color: var(--accent-dark); }

    .err-foot { margin-top: 24px; font-size: 12.5px; color: var(--muted); opacity: .8; }

    @@media (max-width: 480px) {
        .err-card { padding: 34px 20px 24px; }
        .quick { gap: 8px; }
    }
    @@media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
        .fly { display: none; }
    }
</style>

<script>
    // Kartın fareyi takip ederek eğilmesi ve ışığın fareyle birlikte hareket etmesi
    document.addEventListener('DOMContentLoaded', function () {
        var card = document.querySelector('.err-card');
        if (!card || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        card.addEventListener('mousemove', function (e) {
            var r = card.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width;
            var y = (e.clientY - r.top) / r.height;
            card.style.transform = 'perspective(900px) rotateY(' + ((x - 0.5) * 10) + 'deg) rotateX(' + ((0.5 - y) * 10) + 'deg)';
            card.style.setProperty('--mx', (x * 100) + '%');
            card.style.setProperty('--my', (y * 100) + '%');
        });

        card.addEventListener('mouseleave', function () {
            card.style.transform = '';
        });
    });
</script>
