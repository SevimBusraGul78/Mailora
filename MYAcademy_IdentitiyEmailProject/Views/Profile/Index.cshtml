@model ProfileViewModel
@{
    ViewData["Title"] = "Profilim";
    ViewData["ActiveMenu"] = "profile";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var fullName = $"{Model.Name} {Model.Surname}".Trim();
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var initials = string.Concat((string.IsNullOrEmpty(fullName) ? (Model.UserName ?? "?") : fullName)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0], tr)));
    var hasPhoto = !string.IsNullOrEmpty(Model.ImageUrl);

    string? Err(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<style>
    .pf-wrap {
        max-width: 920px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 20px;
    }

    .pf-card {
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 4px 24px rgba(91, 80, 170, .08);
        padding: 28px;
    }

    .pf-side {
        text-align: center;
    }

    .pf-photo {
        position: relative;
        width: 132px;
        height: 132px;
        margin: 4px auto 16px;
    }

    .pf-av {
        width: 132px;
        height: 132px;
        border-radius: 50%;
        overflow: hidden;
        display: grid;
        place-items: center;
        font-size: 44px;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, #A79BEA, #7467C7);
        box-shadow: 0 14px 30px rgba(116, 103, 199, .28);
    }

        .pf-av img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pf-cam {
        position: absolute;
        right: 2px;
        bottom: 6px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 3px solid #fff;
        background: #7467C7;
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-size: 16px;
        transition: transform .2s;
    }

        .pf-cam:hover {
            transform: scale(1.08);
        }

    .pf-name {
        font-size: 19px;
        font-weight: 800;
        margin: 0 0 2px;
    }

    .pf-user {
        color: #85899B;
        font-size: 13.5px;
    }

    .pf-email {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 6px 11px;
        border-radius: 999px;
        background: #F8F9FD;
        color: #5D6075;
        font-size: 12.5px;
        font-weight: 600;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pf-hint {
        margin-top: 14px;
        font-size: 12px;
        color: #A6A9B8;
        line-height: 1.5;
    }

    .pf-remove {
        margin-top: 10px;
        border: 0;
        background: none;
        color: #C2476B;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }

    .pf-photo-err {
        margin-top: 10px;
        font-size: 12.5px;
        font-weight: 600;
        color: #C2476B;
    }

    .pf-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

        .pf-head .ic {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: #EAE6FA;
            color: #7467C7;
            font-size: 20px;
        }

        .pf-head h1 {
            font-size: 20px;
            font-weight: 800;
            margin: 0;
        }

        .pf-head p {
            margin: 0;
            color: #85899B;
            font-size: 13.5px;
        }

    .pf-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .pf-field {
        margin-bottom: 16px;
    }

        .pf-field label {
            display: block;
            font-size: 12.5px;
            font-weight: 700;
            color: #5D6075;
            margin-bottom: 7px;
        }

    .pf-inp {
        width: 100%;
        height: 48px;
        border-radius: 13px;
        border: 1.5px solid #ECEBF5;
        background: #F8F9FD;
        padding: 0 14px;
        font-size: 14.5px;
        outline: none;
        font-family: inherit;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    textarea.pf-inp {
        height: 110px;
        padding: 12px 14px;
        resize: vertical;
        line-height: 1.5;
    }

    .pf-inp:focus {
        background: #fff;
        border-color: #BFB6EE;
        box-shadow: 0 0 0 4px rgba(139, 127, 214, .13);
    }

    .pf-inp[readonly] {
        color: #85899B;
        cursor: not-allowed;
    }

    .pf-field.err .pf-inp {
        border-color: #E9A3B9;
        background: #FFF7F9;
    }

    .pf-err {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #C2476B;
    }

    .pf-count {
        float: right;
        font-weight: 600;
        color: #A6A9B8;
    }

    .pf-btn {
        height: 50px;
        padding: 0 26px;
        border: 0;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg, #9C91E2, #7467C7);
        box-shadow: 0 10px 24px rgba(139, 127, 214, .35);
        transition: transform .2s;
    }

        .pf-btn:hover {
            transform: translateY(-2px);
        }

    .pf-gen-err.validation-summary-valid {
        display: none;
    }

    .pf-gen-err.validation-summary-errors {
        background: #FBE7EE;
        color: #C2476B;
        border-radius: 13px;
        padding: 12px 14px;
        margin-bottom: 18px;
        font-weight: 600;
        font-size: 13.5px;
    }

    .pf-gen-err ul {
        margin: 0;
        padding-left: 18px;
    }

    @@media (max-width: 820px) {
        .pf-wrap {
            grid-template-columns: minmax(0, 1fr);
        }

        .pf-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<form asp-action="Index" method="post" enctype="multipart/form-data" class="pf-wrap" id="pfForm">

    <!-- Sol: fotoğraf -->
    <div class="pf-card pf-side">
        <div class="pf-photo">
            <div class="pf-av" id="pfAvatar">
                @if (hasPhoto)
                {
                    <img src="@Model.ImageUrl" alt="Profil fotoğrafı" id="pfImg">
                }
                else
                {
                    <span id="pfInitials">@initials</span>
                }
            </div>
            <label class="pf-cam" for="Photo" title="Fotoğraf seç"><i class="bi bi-camera-fill"></i></label>
        </div>

        <input type="file" asp-for="Photo" accept=".jpg,.jpeg,.png,.webp" hidden />
        <input type="hidden" asp-for="RemovePhoto" />

        <div class="pf-name">@(string.IsNullOrEmpty(fullName) ? Model.UserName : fullName)</div>
        <div class="pf-user">@@@Model.UserName</div>
        <div class="pf-email"><i class="bi bi-envelope"></i> @Model.Email</div>

        @if (hasPhoto)
        {
            <div><button type="button" class="pf-remove" id="pfRemove"><i class="bi bi-trash3"></i> Fotoğrafı kaldır</button></div>
        }

        <div class="pf-photo-err" id="pfPhotoErr">@Err(nameof(Model.Photo))</div>
        <div class="pf-hint">JPG, PNG veya WEBP · en fazla 2 MB<br>Kare bir fotoğraf en iyi sonucu verir.</div>
    </div>

    <!-- Sağ: bilgiler -->
    <div class="pf-card">
        <div class="pf-head">
            <div class="ic"><i class="bi bi-person-vcard"></i></div>
            <div>
                <h1>Profil Bilgileri</h1>
                <p>Mesajlarında görünen adını ve hakkında kısmını düzenle.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="pf-gen-err"></div>

        <div class="pf-grid">
            <div class="pf-field @(Err(nameof(Model.Name)) != null ? "err" : "")">
                <label for="Name">Ad</label>
                <input class="pf-inp" asp-for="Name" maxlength="50" />
                <div class="pf-err">@Err(nameof(Model.Name))</div>
            </div>
            <div class="pf-field @(Err(nameof(Model.Surname)) != null ? "err" : "")">
                <label for="Surname">Soyad</label>
                <input class="pf-inp" asp-for="Surname" maxlength="50" />
                <div class="pf-err">@Err(nameof(Model.Surname))</div>
            </div>
        </div>

        <div class="pf-grid">
            <div class="pf-field">
                <label>Kullanıcı Adı</label>
                <input class="pf-inp" value="@Model.UserName" readonly />
            </div>
            <div class="pf-field">
                <label>E-posta</label>
                <input class="pf-inp" value="@Model.Email" readonly />
            </div>
        </div>

        <div class="pf-field @(Err(nameof(Model.Description)) != null ? "err" : "")">
            <label for="Description">Hakkımda <span class="pf-count" id="pfCount">0 / 300</span></label>
            <textarea class="pf-inp" asp-for="Description" maxlength="300" placeholder="Kendinden kısaca bahset…"></textarea>
            <div class="pf-err">@Err(nameof(Model.Description))</div>
        </div>

        <button type="submit" class="pf-btn"><i class="bi bi-check2-circle"></i> Kaydet</button>
    </div>
</form>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('Photo');
            const avatar = document.getElementById('pfAvatar');
            const err = document.getElementById('pfPhotoErr');
            const removeFlag = document.getElementById('RemovePhoto');
            const removeBtn = document.getElementById('pfRemove');
            const MAX = 2 * 1024 * 1024;
            const TYPES = ['image/jpeg', 'image/png', 'image/webp'];

            // Fotoğraf seçilince: tarayıcıda hızlı kontrol + önizleme
            input.addEventListener('change', () => {
                const file = input.files[0];
                err.textContent = '';
                if (!file) return;

                if (!TYPES.includes(file.type)) { err.textContent = 'Sadece JPG, PNG veya WEBP seçebilirsin.'; input.value = ''; return; }
                if (file.size > MAX) { err.textContent = 'Fotoğraf en fazla 2 MB olabilir.'; input.value = ''; return; }

                avatar.innerHTML = '';
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.alt = 'Yeni fotoğraf önizleme';
                avatar.appendChild(img);
                removeFlag.value = 'false';
                window.Mailora.showToast('Önizleme hazır. Kaydet\'e basınca yüklenecek.', 'bi-image');
            });

            // Fotoğrafı kaldır
            if (removeBtn) {
                removeBtn.addEventListener('click', () => {
                    removeFlag.value = 'true';
                    input.value = '';
                    avatar.innerHTML = '<span>@initials</span>';
                    removeBtn.hidden = true;
                    window.Mailora.showToast('Fotoğraf kaldırılacak. Kaydet\'e bas.', 'bi-trash3');
                });
            }

            // Hakkımda karakter sayacı
            const desc = document.getElementById('Description');
            const count = document.getElementById('pfCount');
            const update = () => { count.textContent = `${desc.value.length} / 300`; };
            desc.addEventListener('input', update);
            update();
        })();
    </script>
}