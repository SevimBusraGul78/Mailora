@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["MailoSay"] = "Merak etme, herkes unutur 😊 Birlikte halledelim!";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Şifremi Unuttum · Mailora</title>
    <partial name="_MailoStyle" />
</head>
<body>
    <div class="m-bg" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span></div>

    <main class="m-page">
        <div class="m-card">
            <partial name="_MailoStage" />

            <section class="m-form">
                <div class="m-head">
                    <span class="pill"><i class="bi bi-key"></i> Şifre yenileme</span>
                    <h1>Şifreni mi <span class="grad">unuttun?</span></h1>
                    <p>Hesabına kayıtlı e-posta adresini yaz, sana şifre yenileme bağlantısı gönderelim.</p>
                </div>

                <form method="post" id="forgotForm">
                    <div asp-validation-summary="All" class="form-alert"></div>

                    <div class="field">
                        <label for="Email">E-posta</label>
                        <div class="iw">
                            <i class="bi bi-envelope lead"></i>
                            <input class="inp" asp-for="Email" type="email" placeholder="ad.soyad@ornek.com" autocomplete="email" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-main" id="forgotBtn">
                        <span class="lbl">Bağlantı Gönder</span>
                        <i class="bi bi-send ic"></i>
                        <span class="spin"></span>
                    </button>

                    <div class="m-foot">
                        Şifreni hatırladın mı? <a asp-controller="Login" asp-action="SignIn">Giriş yap</a>
                    </div>
                </form>
            </section>
        </div>
    </main>

    <script>
        var M = window.Mailo;
        M.watch(document.getElementById('Email'), 'Bağlantıyı bu adrese yollayacağım 📬');

        document.getElementById('forgotForm').addEventListener('submit', function () {
            var b = document.getElementById('forgotBtn');
            b.classList.add('is-loading');
            b.querySelector('.lbl').textContent = 'Gönderiliyor';
            M.mood('happy'); M.say('Mektubu hazırlıyorum... ✉️'); M.jump();
        });
    </script>
</body>
</html>