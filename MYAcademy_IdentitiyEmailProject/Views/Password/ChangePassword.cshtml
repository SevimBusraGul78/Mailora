@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActiveMenu"] = "settings";
    Layout = "~/Views/MessageLayout/Index.cshtml";
}

<style>
    .cp-wrap { max-width: 640px; margin: 0 auto; }
    .cp-card { background: #fff; border-radius: 22px; padding: 32px 34px; box-shadow: 0 4px 24px rgba(91, 80, 170, .08); }
    .cp-head { display: flex; gap: 16px; align-items: center; margin-bottom: 24px; }
    .cp-ic { width: 54px; height: 54px; border-radius: 16px; flex: 0 0 54px; display: grid; place-items: center; font-size: 24px; background: #EAE6FA; color: #7467C7; }
    .cp-head h1 { font-size: 22px; font-weight: 800; margin: 0 0 4px; }
    .cp-head p { margin: 0; color: #85899B; font-size: 14px; }
    .cp-field { margin-bottom: 16px; }
    .cp-field label { display: block; font-size: 12.5px; font-weight: 700; color: #5D6075; margin-bottom: 7px; }
    .cp-iw { position: relative; }
    .cp-iw > i.lead { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #A6A9B8; }
    .cp-inp { width: 100%; height: 48px; border-radius: 13px; border: 1.5px solid #ECEBF5; background: #F8F9FD; padding: 0 44px 0 42px; font-size: 14.5px; outline: none; font-family: inherit; transition: border-color .2s, box-shadow .2s, background .2s; }
    .cp-inp:focus { background: #fff; border-color: #BFB6EE; box-shadow: 0 0 0 4px rgba(139, 127, 214, .13); }
    .cp-eye { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border: 0; border-radius: 10px; background: transparent; color: #8D90A3; cursor: pointer; }
    .cp-eye:hover { background: #EAE6FA; color: #7467C7; }
    .cp-divider { height: 1px; background: #ECEBF5; margin: 22px 0; }
    .cp-meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 9px; }
    .cp-meter span { height: 5px; border-radius: 5px; background: #ECEBF5; transition: background .3s; }
    .cp-meter[data-l="1"] span:nth-child(-n+1) { background: #E07597; }
    .cp-meter[data-l="2"] span:nth-child(-n+2) { background: #F0B48A; }
    .cp-meter[data-l="3"] span:nth-child(-n+3) { background: #8B7FD6; }
    .cp-meter[data-l="4"] span:nth-child(-n+4) { background: #5CC09A; }
    .cp-match { display: none; font-size: 12px; font-weight: 600; margin-top: 7px; }
    .cp-match.ok { display: block; color: #3E9A77; }
    .cp-match.no { display: block; color: #C2476B; }
    .cp-btn { width: 100%; height: 50px; border: 0; border-radius: 14px; margin-top: 8px; font-size: 15px; font-weight: 700; color: #fff; cursor: pointer; background: linear-gradient(135deg, #9C91E2, #7467C7); box-shadow: 0 10px 24px rgba(139, 127, 214, .35); transition: transform .2s; }
    .cp-btn:hover { transform: translateY(-2px); }
    .cp-ok { display: flex; gap: 10px; align-items: center; background: #E3F5EE; color: #3E9A77; border-radius: 13px; padding: 12px 14px; margin-bottom: 18px; font-weight: 600; font-size: 13.5px; }
    .cp-err.validation-summary-valid { display: none; }
    .cp-err.validation-summary-errors { background: #FBE7EE; color: #C2476B; border-radius: 13px; padding: 12px 14px; margin-bottom: 18px; font-weight: 600; font-size: 13.5px; }
    .cp-err ul { margin: 0; padding-left: 18px; }
    .cp-note { display: flex; gap: 10px; margin-top: 18px; padding: 12px 14px; border-radius: 12px; background: #F8F9FD; color: #5D6075; font-size: 12.5px; line-height: 1.5; }
    .cp-note i { color: #8B7FD6; }
</style>

<div class="cp-wrap">
    <div class="cp-card">
        <div class="cp-head">
            <div class="cp-ic"><i class="bi bi-shield-lock"></i></div>
            <div>
                <h1>Şifre Değiştir</h1>
                <p>Hesabının güvenliği için şifreni düzenli olarak yenile.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="cp-ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
        }

        <form method="post" id="cpForm">
            <div asp-validation-summary="All" class="cp-err"></div>

            <div class="cp-field">
                <label for="CurrentPassword">Mevcut Şifre</label>
                <div class="cp-iw">
                    <i class="bi bi-key lead"></i>
                    <input class="cp-inp" asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                    <button type="button" class="cp-eye" data-eye="CurrentPassword"><i class="bi bi-eye"></i></button>
                </div>
            </div>

            <div class="cp-divider"></div>

            <div class="cp-field">
                <label for="NewPassword">Yeni Şifre</label>
                <div class="cp-iw">
                    <i class="bi bi-lock lead"></i>
                    <input class="cp-inp" asp-for="NewPassword" type="password" autocomplete="new-password" required />
                    <button type="button" class="cp-eye" data-eye="NewPassword"><i class="bi bi-eye"></i></button>
                </div>
                <div class="cp-meter" id="cpMeter" data-l="0"><span></span><span></span><span></span><span></span></div>
            </div>

            <div class="cp-field">
                <label for="NewPasswordConfirm">Yeni Şifre Tekrar</label>
                <div class="cp-iw">
                    <i class="bi bi-shield-check lead"></i>
                    <input class="cp-inp" asp-for="NewPasswordConfirm" type="password" autocomplete="new-password" required />
                    <button type="button" class="cp-eye" data-eye="NewPasswordConfirm"><i class="bi bi-eye"></i></button>
                </div>
                <div class="cp-match" id="cpMatch"></div>
            </div>

            <button type="submit" class="cp-btn">Şifremi Değiştir</button>

            <div class="cp-note">
                <i class="bi bi-info-circle"></i>
                <span>Şifren en az 6 karakter olmalı; büyük harf, küçük harf, rakam ve sembol içermeli. Değişiklikten sonra mailine bilgi gönderilir.</span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Şifreyi göster / gizle
        document.querySelectorAll('[data-eye]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.eye);
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });
        });

        // Şifre gücü ve eşleşme
        var np = document.getElementById('NewPassword');
        var np2 = document.getElementById('NewPasswordConfirm');
        var match = document.getElementById('cpMatch');

        np.addEventListener('input', function () {
            var v = np.value;
            var score = [v.length >= 6, /[A-ZÇĞİÖŞÜ]/.test(v), /[a-zçğıöşü]/.test(v), /\d/.test(v), /[^A-Za-z0-9ÇĞİÖŞÜçğıöşü]/.test(v)].filter(Boolean).length;
            document.getElementById('cpMeter').dataset.l = v ? Math.max(1, Math.min(4, score - 1)) : 0;
            checkMatch();
        });

        function checkMatch() {
            if (!np2.value) { match.className = 'cp-match'; return; }
            var same = np.value === np2.value;
            match.className = 'cp-match ' + (same ? 'ok' : 'no');
            match.textContent = same ? '✓ Şifreler eşleşiyor' : 'Şifreler eşleşmiyor';
        }
        np2.addEventListener('input', checkMatch);
    </script>
}