@{
    Layout = null;
    ViewData["MailoSay"] = "Mektubu yola çıkardım! 💌 Gelen kutuna bir bak.";
    var email = ViewBag.Email as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Bağlantı Gönderildi · Mailora</title>
    <partial name="_MailoStyle" />
</head>
<body>
    <div class="m-bg" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span></div>

    <main class="m-page">
        <div class="m-card">
            <partial name="_MailoStage" />

            <section class="m-form">
                <div class="m-head">
                    <div class="state-ic ok"><i class="bi bi-envelope-check"></i></div>
                    <h1>Mailini <span class="grad">kontrol et</span></h1>
                    <p>
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <b>@email</b>
                        }
                        adresi sistemde kayıtlıysa şifre yenileme bağlantısını gönderdik. Bağlantı <b>1 saat</b> geçerli.
                    </p>
                </div>

                <div class="tips">
                    <div class="tip"><i class="bi bi-inbox"></i><span>Mail birkaç dakika içinde gelmezse <b>Spam</b> ve <b>Promosyonlar</b> klasörlerine bak.</span></div>
                    <div class="tip"><i class="bi bi-shield-lock"></i><span>Bağlantı tek kullanımlık. Şifreni yeniledikten sonra tekrar çalışmaz.</span></div>
                </div>

                <a class="btn-main" href="https://mail.google.com" target="_blank" rel="noopener" style="text-decoration:none">
                    <span class="lbl">Gmail'i Aç</span><i class="bi bi-box-arrow-up-right ic"></i>
                </a>

                <div class="m-foot">
                    Mail gelmedi mi? <a asp-action="ForgotPassword">Tekrar gönder</a> · <a asp-controller="Login" asp-action="SignIn">Giriş yap</a>
                </div>
            </section>
        </div>
    </main>

    <script>
        window.Mailo.mood('happy');
        setTimeout(function () { window.Mailo.jump(); }, 400);
    </script>
</body>
</html>