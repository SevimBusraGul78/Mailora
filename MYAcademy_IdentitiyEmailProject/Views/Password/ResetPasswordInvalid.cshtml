@{
    Layout = null;
    ViewData["MailoSay"] = "Ah, bu bağlantı artık çalışmıyor 😕 Ama yenisini isteyebilirsin!";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Bağlantı Geçersiz · Mailora</title>
    <partial name="_MailoStyle" />
</head>
<body>
    <div class="m-bg" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span></div>

    <main class="m-page">
        <div class="m-card">
            <partial name="_MailoStage" />

            <section class="m-form">
                <div class="m-head">
                    <div class="state-ic bad"><i class="bi bi-link-45deg"></i></div>
                    <h1>Bağlantı <span class="grad">geçersiz</span></h1>
                    <p>Bu şifre yenileme bağlantısının süresi dolmuş, daha önce kullanılmış ya da hatalı olabilir.</p>
                </div>

                <div class="tips">
                    <div class="tip"><i class="bi bi-clock-history"></i><span>Bağlantılar güvenlik için <b>1 saat</b> geçerlidir.</span></div>
                    <div class="tip"><i class="bi bi-shield-check"></i><span>Her bağlantı yalnızca <b>bir kez</b> kullanılabilir.</span></div>
                </div>

                <a class="btn-main" asp-action="ForgotPassword" style="text-decoration:none">
                    <span class="lbl">Yeni Bağlantı İste</span><i class="bi bi-arrow-repeat ic"></i>
                </a>

                <div class="m-foot">
                    <a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a>
                </div>
            </section>
        </div>
    </main>

    <script>
        window.Mailo.mood('sad');
        setTimeout(function () { window.Mailo.shake(); }, 400);
    </script>
</body>
</html>